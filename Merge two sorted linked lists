class Solution {
  public:
    Node* sortedMerge(Node* head1, Node* head2) {
        // code here
        Node*ans = new Node(-1);
        Node*ansHead = ans;
        while(head1 && head2){
            if(head1->data >= head2->data){
                ans->next = head2;
                ans = head2;
                head2 = head2 ->next;
            }
            else{
                ans->next = head1;
                ans = head1;
                head1 = head1->next;
            }
        }
        if(head1 != NULL){
            ans->next = head1;
        }
        if(head2 != NULL){
            ans->next = head2;
        }
        return ansHead->next;
    }
};
